# EditorConfig — consistent basics across all editors (https://editorconfig.org)
# Applies to every file in this workspace, including projects/.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# PHP follows PSR-12 (4-space indentation)
[*.php]
indent_size = 4

# Markdown: keep trailing spaces (they can mean intentional line breaks)
[*.md]
trim_trailing_whitespace = false

# Windows-native scripts expect CRLF
[*.{ps1,psm1,psd1,bat,cmd}]
end_of_line = crlf
indent_size = 4
